# Salin file ini menjadi ".env" dan isi sesuai kredensial Anda.
# JANGAN commit file .env asli ke Git.

PORT=4000

# --- Database TiDB (kompatibel MySQL) ---
# Ambil nilai ini dari dashboard TiDB Cloud > Connect
DB_HOST=gateway01.xx-xx-x.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=isi_password_tidb
DB_NAME=undangan_digital
# TiDB Cloud Serverless mewajibkan koneksi TLS/SSL
DB_SSL=true

# --- JWT (autentikasi login) ---
JWT_SECRET=ganti_dengan_string_acak_yang_panjang_dan_rahasia
JWT_EXPIRES_IN=7d

# --- Login dengan Google ---
# Ambil dari Google Cloud Console > APIs & Services > Credentials (OAuth Client ID, tipe "Web application")
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Midtrans ---
# Ambil dari dashboard Midtrans > Settings > Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- URL Frontend (untuk redirect Midtrans & CORS) ---
FRONTEND_URL=https://nama-app-anda.vercel.app
